+# How many times the stream of one game is re-opened after a single break before the game is given
+# up on. The wait doubles from a second between attempts, so the attempts span about fifteen seconds
+# on top of whatever `api_get` itself spends retrying (it rides out 5xx for up to a minute).
+GAME_STREAM_RECONNECT_TRIES = 5
+
+
+def reopen_game_stream(li: lichess.Lichess, game: model.Game, game_streams: contextlib.ExitStack,
+                       ended_by: BaseException) -> Iterator[bytes] | None:
+    """
+    Re-open the stream of a game that is not over yet, or return None if it cannot be resumed.
+
+    A game stream can end at any moment -- lichess restarts, a proxy drops the connection, a network
+    blip -- and the end of the stream is not the end of the game. The game keeps running on lichess
+    and its clocks keep ticking, so the stream has to be re-opened or the game is lost on time.
+
+    lichess sends the full game as the first event of a game stream, so re-opening resynchronises the
+    position, both clocks and whose turn it is. Its `state` is handed back as the next `gameState`
+    update, which is exactly what `play_game` does with the state it opens a game with, so the caller
+    needs no special case: it moves if it is on move, reports the result if the game finished while we
+    were away, and plays on otherwise.
+
+    :param ended_by: The failure that ended the previous stream. Always logged, never swallowed.
+    :return: The updates of the new stream, or None if this game is over for us.
+    """
+    logger.warning(f"The game stream of {game.url()} ended with {type(ended_by).__name__}: {ended_by}, but the "
+                   "game is not over. Re-opening the stream to resume play.")
+    wait = seconds(1)
+    for attempt in range(1, GAME_STREAM_RECONNECT_TRIES + 1):
+        if stop.terminated or stop.force_quit:
+            logger.warning(f"Giving up on the game stream of {game.url()}: lichess-bot is shutting down.")
+            return None
+        # Closing the streams opened for this game so far releases the sockets of the broken one and
+        # of any attempt that connected but then failed. The stack is reused for the new stream.
+        game_streams.close()
+        try:
+            response = game_streams.enter_context(li.get_game_stream(game.id))
+            lines = response.iter_lines()
+            state = cast(GameEventType, json.loads(next(lines).decode("utf-8")))["state"]
+            logger.warning(f"Re-opened the game stream of {game.url()} on attempt {attempt} of "
+                           f"{GAME_STREAM_RECONNECT_TRIES}. Resynchronised state: {state}")
+            return itertools.chain([json.dumps(state).encode("utf-8")], lines)
+        except (HTTPError, ReadTimeout, RemoteDisconnected, ChunkedEncodingError, RequestsConnectionError,
+                StopIteration, lichess.RateLimitedError) as e:
+            status = e.response.status_code if isinstance(e, HTTPError) and e.response is not None else None
+            if status is not None and status < 500 and status != 429:
+                # lichess answered, and the answer is no: the game is gone (404 once lichess forgets
+                # it) or this token may not read it. No number of retries changes that.
+                logger.error(f"Cannot re-open the game stream of {game.url()}: lichess refuses the request with "
+                             f"HTTP {status} ({e}). This game is over for us.")
+                return None
+            retry_in = e.timeout if isinstance(e, lichess.RateLimitedError) else wait
+            last = attempt == GAME_STREAM_RECONNECT_TRIES
+            logger.warning(f"Attempt {attempt} of {GAME_STREAM_RECONNECT_TRIES} to re-open the game stream of "
+                           f"{game.url()} failed with {type(e).__name__}: {e}. "
+                           + ("That was the last attempt." if last else f"Retrying in {to_seconds(retry_in):.1f} seconds."))
+            if not last:
+                time.sleep(to_seconds(retry_in))
+            wait *= 2
+    logger.error(f"Gave up re-opening the game stream of {game.url()} after {GAME_STREAM_RECONNECT_TRIES} attempts. "
+                 "The game is left unplayed and will be lost on time unless lichess starts it again.")
+    return None
+
